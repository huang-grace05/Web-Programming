<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
  </head>

  <body>
    <%- include('partials/header') %>

    <main>
      <h2><%= title %></h2>

      <% if (entries.length === 0) { %>
        <p>No entries yet.</p>
      <% } else { %>
        <ul class="entry-list">
          <% entries.forEach((entry, index) => { %>
            <li>
              <a href="/entries/<%= index %>">
                <%= entry.title %>
              </a>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </main>

    <footer>
      <p>COMPSCI 326</p>
    </footer>
  </body>
</html>